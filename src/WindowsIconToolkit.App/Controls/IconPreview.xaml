<UserControl
    x:Class="WindowsIconToolkit.Controls.IconPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="88" Height="88" IsTabStop="False">
    <Grid UseLayoutRounding="True">
        <FontIcon x:Name="FallbackIcon" Glyph="&#xE70B;" FontSize="56" />
        <Image x:Name="ApplicationImage" Margin="8" Stretch="Uniform" />
        <Image x:Name="ArrowImage" Width="25" Height="25" Stretch="Uniform"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,3"
               Visibility="{x:Bind ArrowVisibility, Mode=OneWay}" />
        <Image x:Name="ShieldImage" Width="28" Height="30" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
               Visibility="{x:Bind ShieldVisibility, Mode=OneWay}" />
    </Grid>
</UserControl>
