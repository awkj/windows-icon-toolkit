<Window
    x:Class="WindowsIconToolkit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows Icon Toolkit">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <NavigationView IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    PaneDisplayMode="Left" IsPaneToggleButtonVisible="False"
                    OpenPaneLength="228" IsTitleBarAutoPaddingEnabled="True">
        <NavigationView.PaneHeader>
            <StackPanel Margin="20,28,12,28" Spacing="6">
                <TextBlock Text="ICON TOOLKIT" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="让桌面回归清爽" Opacity="0.65" FontSize="12" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="桌面图标" IsSelected="True" IsHitTestVisible="False">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <StackPanel Margin="20,12,16,24" Spacing="4">
                <TextBlock Text="Windows Icon Toolkit" FontSize="12" />
                <TextBlock Text="预览版 0.1 · 可恢复的外观调整" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </NavigationView.PaneFooter>
        <ScrollViewer>
            <StackPanel Margin="36,32,36,32" Spacing="20" MaxWidth="900" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="桌面图标" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="调整图标角标，保留熟悉的使用方式。" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="快捷方式箭头" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="隐藏左下角小箭头。快捷方式仍可正常打开和固定到任务栏。" TextWrapping="Wrap" Opacity="0.75" />
                        <TextBlock Text="{x:Bind ViewModel.ArrowStatus, Mode=OneWay}" TextWrapping="Wrap" />
                        <Button Content="隐藏快捷方式箭头" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.HideArrowsCommand}" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="管理员盾牌" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="尝试隐藏蓝黄盾牌。管理员权限要求与 UAC 授权弹窗保持原样。" TextWrapping="Wrap" Opacity="0.75" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="实验性功能"
                                 Message="已写入设置不代表桌面一定生效，效果取决于 Windows 版本与程序。" />
                        <TextBlock Text="{x:Bind ViewModel.ShieldStatus, Mode=OneWay}" TextWrapping="Wrap" />
                        <Button Content="隐藏箭头并尝试隐藏盾牌" Command="{x:Bind ViewModel.HideBothCommand}"
                                IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="恢复与刷新" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="恢复修改前的角标设置。重启资源管理器时，任务栏和桌面会短暂消失，打开的文件夹窗口可能关闭。" TextWrapping="Wrap" Opacity="0.75" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="恢复原设置" Command="{x:Bind ViewModel.RestoreCommand}" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                            <Button Content="重启资源管理器" Click="RestartExplorer_Click" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.75" />
                </Grid>
                <Button Content="重新读取当前设置" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </NavigationView>
</Window>
