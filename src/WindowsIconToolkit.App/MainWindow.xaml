<Window
    x:Class="WindowsIconToolkit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindowsIconToolkit.Controls"
    Title="Windows Icon Toolkit">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <ScrollViewer>
        <StackPanel Margin="24,20,24,20" Spacing="18" UseLayoutRounding="True">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="Heading" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Uid="Introduction" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock x:Uid="BeforeLabel" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        <controls:IconPreview x:Uid="BeforePreview" />
                        <TextBlock x:Uid="BeforeAppName" HorizontalAlignment="Center" FontSize="14" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="18" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="2" Spacing="12" HorizontalAlignment="Center">
                        <TextBlock x:Uid="AfterLabel" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        <controls:IconPreview ArrowVisibility="{x:Bind ViewModel.PreviewArrowVisibility, Mode=OneWay}"
                                              ShieldVisibility="{x:Bind ViewModel.PreviewShieldVisibility, Mode=OneWay}"
                                              AutomationProperties.Name="{x:Bind ViewModel.PreviewDescription, Mode=OneWay}" />
                        <TextBlock x:Uid="AfterAppName" HorizontalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Spacing="6">
                <CheckBox x:Uid="HideArrowOption" IsChecked="{x:Bind ViewModel.HideArrow, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" FontSize="15" />
                <CheckBox x:Uid="HideShieldOption" IsChecked="{x:Bind ViewModel.HideShield, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" FontSize="15" />
            </StackPanel>
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Uid="ApplyButton" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ApplySelectionCommand}" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                    <Button x:Uid="RestoreButton" Command="{x:Bind ViewModel.RestoreCommand}"
                            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                </StackPanel>
                <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Uid="RestartExplorerButton" Click="RestartExplorer_Click" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                        <Button x:Uid="RefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                    </StackPanel>
                    <HyperlinkButton x:Uid="VersionButton" Grid.Column="1" Content="{x:Bind VersionLabel}" Click="Version_Click"
                                     VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
