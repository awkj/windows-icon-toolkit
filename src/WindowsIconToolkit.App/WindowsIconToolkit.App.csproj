<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WindowsIconToolkit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>0.2.3</Version>
    <Product>Windows Icon Toolkit</Product>
    <Description>Preview and adjust Windows desktop icon overlays.</Description>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en;en-US;zh-CN;zh-Hans</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\scripts\Desktop-IconOverlays.ps1" Link="Backend\Desktop-IconOverlays.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Unpackaged publish omits project PRI/XBF files in the SDK; see WindowsAppSDK#6720. -->
  <Target Name="PublishToolkitXamlResources" BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)" Condition="'$(WindowsPackageType)' == 'None'">
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="The application PRI was not generated; refusing to publish an incomplete app." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ToolkitCompiledXaml Include="$(TargetDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(ToolkitCompiledXaml)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(ToolkitCompiledXaml.RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="FilterToolkitResourceLanguages" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ToolkitUnusedLocale Include="@(ResolvedFileToPublish)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*[\\/]')) and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^(?i:en|en-US|zh-CN|zh-Hans)[\\/]'))" />
      <ResolvedFileToPublish Remove="@(ToolkitUnusedLocale)" />
    </ItemGroup>
  </Target>
  <Target Name="AuditToolkitBundle" AfterTargets="PrepareForBundle">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\..\..\.build\bundle-files-$(Configuration).txt"
                      Lines="@(FilesToBundle->'%(RelativePath)')" Overwrite="true" />
  </Target>
</Project>
