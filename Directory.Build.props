<Project>
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory).build\out\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**;$(MSBuildThisFileDirectory).build\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
